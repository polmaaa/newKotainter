                  "oracle_tns": {"type": "string"},
                  "oracle_username": {"type": "string"},
                  "oracle_password": {"type": "string"},
                  "postgres_host": {"type": "string"},
                  "postgres_port": {"type": "integer"},
                  "postgres_username": {"type": "string"},
                  "postgres_password": {"type": "string"},
                  "postgres_database": {"type": "string"},
                  "fso_oracle_tns": {"type": "string"},
                  "fso_oracle_username": {"type": "string"},
                  "fso_oracle_password": {"type": "string"},
                  "fso_postgres_host": {"type": "string"},
                  "fso_postgres_port": {"type": "integer"},
                  "fso_postgres_username": {"type": "string"},
                  "fso_postgres_password": {"type": "string"},
                  "fso_postgres_database": {"type": "string"},
                  "postgres_crm_host": {"type": "string"},
                  "postgres_crm_port": {"type": "integer"},
                  "postgres_crm_username": {"type": "string"},
                  "postgres_crm_password": {"type": "string"},
                  "postgres_crm_database": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Konfigurasi berhasil disimpan"
          }
        }
      }
    },
