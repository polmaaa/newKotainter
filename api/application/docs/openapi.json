{
  "openapi": "3.0.3",
  "info": {
    "title": "NewKotainter v2.0 REST API Docs",
    "version": "2.0.0",
    "description": "Dokumentasi Lengkap API Backend NewKotainter v2.0 (Oracle & PostgreSQL)."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Environment"
    }
  ],
  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ci_session",
        "description": "Autentikasi menggunakan cookie session PHP/CodeIgniter setelah login berhasil."
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "message": {
            "type": "string",
            "example": "Operasi berhasil"
          },
          "data": {
            "type": "object",
            "nullable": true
          }
        }
      }
    }
  },
  "security": [
    {
      "SessionCookie": []
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Login Pengguna",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": {"type": "string", "example": "admin"},
                  "password": {"type": "string", "format": "password", "example": "password"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login berhasil, session cookie akan disimpan oleh browser",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"}
              }
            }
          },
          "400": {
            "description": "Username atau password kosong"
          },
          "401": {
            "description": "Kredensial tidak valid"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Cek Status Session Aktif",
        "responses": {
          "200": {
            "description": "Session valid",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"}
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Logout Pengguna",
        "responses": {
          "200": {
            "description": "Logout berhasil"
          }
        }
      }
    },
